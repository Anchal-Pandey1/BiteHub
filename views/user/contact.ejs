<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>

    <link rel="stylesheet" href="/css/contact.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>
<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <div class="logo">

            <img src="images/logo.png" alt="logo">

            <div>
                <h2>FoodZone</h2>
                <span>Food Management System</span>
            </div>

        </div>

        <ul>

            <li><a href="index.html">Home</a></li>

            <li><a href="foodmenu.html">Menu</a></li>

            <li><a href="orders.html">Orders</a></li>

            <li><a href="about.html">About</a></li>

            <li><a class="active" href="#">Contact</a></li>

        </ul>

        <a href="login.html" class="loginBtn">

            <i class="fa-solid fa-user"></i>

            Login

        </a>

    </nav>



    <!-- ================= MAIN ================= -->

    <section class="contactSection">

        <!-- LEFT CARD -->

        <div class="profileCard">

            <img src="images/my-photo.jpg" alt="My Photo">

            <h2>Your Name</h2>

            <p>Frontend Developer</p>

            <div class="social">

                <i class="fab fa-linkedin"></i>

                <i class="fab fa-github"></i>

                <i class="fab fa-instagram"></i>

            </div>

        </div>



        <!-- CENTER CARD -->

        <div class="contactCard">

            <div class="icon">

                <i class="fa-solid fa-headset"></i>

            </div>

            <h1>Contact Us</h1>

            <p>We would love to hear from you!</p>


            <div class="content">


                <!-- LEFT INFO -->

                <div class="info">

                    <div class="box">

                        <i class="fa-solid fa-location-dot"></i>

                        <div>

                            <h3>Address</h3>

                            <p>Prayagraj, Uttar Pradesh</p>

                        </div>

                    </div>


                    <div class="box">

                        <i class="fa-solid fa-phone"></i>

                        <div>

                            <h3>Phone</h3>

                            <p>+91 9876543210</p>

                        </div>

                    </div>


                    <div class="box">

                        <i class="fa-solid fa-envelope"></i>

                        <div>

                            <h3>Email</h3>

                            <p>foodzone@gmail.com</p>

                        </div>

                    </div>


                    <div class="box">

                        <i class="fa-solid fa-clock"></i>

                        <div>

                            <h3>Working Hours</h3>

                            <p>9 AM - 10 PM</p>

                        </div>

                    </div>

                </div>



                <!-- RIGHT FORM -->

                <form>

                    <input type="text" placeholder="Your Name">

                    <input type="email" placeholder="Your Email">

                    <input type="text" placeholder="Phone Number">

                    <textarea placeholder="Write your message"></textarea>

                    <button>Send Message</button>

                </form>


            </div>

        </div>




        <!-- RIGHT CARD -->

        <div class="profileCard">

            <img src="images/friend-photo.jpg" alt="Friend">

            <h2>Friend Name</h2>

            <p>Backend Developer</p>

            <div class="social">

                <i class="fab fa-linkedin"></i>

                <i class="fab fa-github"></i>

                <i class="fab fa-instagram"></i>

            </div>

        </div>

    </section>



    <footer>

        © 2026 Food Management System

    </footer>

<script src="/contact.js"></script>

</body>
</html>